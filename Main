-- Guard data (live from game configs: WalkSpeed + HitDistance per area)
local GuardCfg = {}
pcall(function()
    for _, m in ipairs(ReplicatedStorage.Data.Guards.Configs:GetChildren()) do
        local ok, cfg = pcall(require, m)
        if ok and type(cfg) == "table" and cfg.WalkSpeed then
            GuardCfg[m.Name] = { speed = tonumber(cfg.WalkSpeed) or 60, hit = tonumber(cfg.HitDistance) or 5 }
        end
    end
end)
local function guardStat(area)
    local g = GuardCfg[area]
    if g then return g.speed, g.hit end
    return 100, 5
end

-- v7 bypasses merged from sources/: validate hook + knockback disconnect
local function gcFindValidate()
    local exact, fallback, fallbackDesc = nil, nil, nil
    pcall(function()
        for _, f in next, getgc() do
            if typeof(f) == 'function' and islclosure and islclosure(f) then
                local okUv, upvs = pcall(debug.getupvalues, f)
                if okUv and type(upvs) == 'table' then
                    local nuv = 0
                    local hasHum = false
                    for _, uv in pairs(upvs) do
                        nuv = nuv + 1
                        if type(uv) == 'table' and rawget(uv, 'Humanoid') then hasHum = true end
                    end
                    if hasHum then
                        local okLn, line = pcall(debug.info, f, 'l')
                        if nuv == 19 and okLn and line == 605 then
                            exact = f
                            break
                        elseif not fallback and nuv >= 17 and nuv <= 20 then
                            local score = 0
                            local okC, consts = pcall(debug.getconstants, f)
                            if okC and type(consts) == 'table' then
                                for _, c in ipairs(consts) do
                                    if type(c) == 'string' and (c:find('strict') or c:find('econcile') or c:find('alid')) then
                                        score = score + 1
                                    end
                                end
                            end
                            local okN, nm = pcall(debug.info, f, 'n')
                            fallback = f
                            fallbackDesc = 'upv=' .. nuv .. ' line=' .. tostring(okLn and line) .. ' fn=' .. tostring(okN and nm) .. ' hints=' .. score
                        end
                    end
                end
            end
        end
    end)
    if exact then return exact, 'exact(19@605)' end
    return fallback, fallbackDesc
end

local function setSpeedBypass(on)
    speedBypassOn = on
    if on then
        if typeof(getgc) ~= 'function' or typeof(hookfunction) ~= 'function' or typeof(islclosure) ~= 'function' then
            Library:Notify('Bypass needs getgc + hookfunction + islclosure', 3)
            return
        end
        local nlc = newlclosure or function(fn) return fn end
        local target, desc = gcFindValidate()
        if not target then Library:Notify('Validate fn not found for this build', 3) return end
        local okUv, v7 = pcall(debug.getupvalue, target, 2)
        if not okUv or not v7 then Library:Notify('Validate upvalue missing', 3) return end
        local orig = nil
        local okH = pcall(function()
            orig = hookfunction(v7, nlc(function(p1, p2)
                if p2 and typeof(p2) == 'table' then pcall(setmetatable, p2, {}) end
                return orig(p1, p2)
            end))
        end)
        if okH and orig then
            bypassV7ref = v7
            bypassOrigValidate = orig
            Library:Notify('Speed Bypass: ON (' .. tostring(desc) .. ')', 3)
        else
            Library:Notify('Speed Bypass hook failed', 3)
        end
    else
        if bypassV7ref and bypassOrigValidate then
            pcall(hookfunction, bypassV7ref, bypassOrigValidate)
            bypassV7ref = nil
            bypassOrigValidate = nil
        end
        Library:Notify('Speed Bypass: OFF (hook restored)', 2)
    end
end

local function disableKnockback()
    if knockbackOff then Library:Notify('Knockback already off', 2) return end
    if typeof(getconnections) ~= 'function' then
        Library:Notify('Knockback needs getconnections', 3)
        return
    end
    local re = Networking:FindFirstChild('RE/RigSync/Refresh')
    if not re then Library:Notify('RigSync remote missing', 3) return end
    local ok, conns = pcall(function() return getconnections(re.OnClientEvent) end)
    if not ok or type(conns) ~= 'table' then Library:Notify('No connections found', 3) return end
    local n = 0
    for _, c in ipairs(conns) do
        if pcall(function() c:Disconnect() end) then n = n + 1 end
    end
    knockbackOff = true
    Library:Notify('Knockback OFF (' .. n .. ' cut, rejoin to undo)', 3)
end

