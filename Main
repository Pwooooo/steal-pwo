    Text = "Auto Buy (Trails + Treadmills + Base)",
    Default = false,
    Tooltip = "Buys affordable trails, treadmill tiers and base upgrades",
    Callback = function(v)
        autoBuy = v
        if v then startAutoBuy() Library:Notify("Auto Buy: ON", 2)
        else
            if autoBuyThread then task.cancel(autoBuyThread) autoBuyThread = nil end
            Library:Notify("Auto Buy: OFF", 2)
        end
    end,
})
LeftShop:AddLabel("Buys cheapest affordable upgrades first.\nRuns every 0.5s while ON.")

