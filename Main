local LeftSell = Tabs.Sell:AddLeftGroupbox("Auto Sell")
LeftSell:AddToggle("AutoSell", {
    Text = "Auto Sell Pets",
    Default = false,
    Tooltip = "Sells pets matching rarities every 1s",
    Callback = function(v)
        autoSell = v
        if v then startAutoSell() Library:Notify("Auto Sell: ON", 2)
        else
            if autoSellThread then task.cancel(autoSellThread) autoSellThread = nil end
            Library:Notify("Auto Sell: OFF", 2)
        end
    end,
})
LeftSell:AddDropdown("SellRarities", {
    Values = {"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Cosmic", "Divine", "Eternal", "Secret"},
    Default = {"Common", "Uncommon", "Rare"},
    Multi = true,
    Text = "Sell rarities",
    Callback = function(v) sellSet = v end,
})

local function startAutoSell()
    if autoSellThread then task.cancel(autoSellThread) autoSellThread = nil end
    autoSellThread = task.spawn(function()
        while autoSell do
            local ok, d = pcall(Save.Get)
            if ok and type(d) == "table" and type(d.EggInventory) == "table" then
                for uid, ed in pairs(d.EggInventory) do
                    if not autoSell then break end
                    if type(ed) == "table" and not ed.Placement then
                        local rar = nil
                        pcall(function()
                            rar = AssetsDir[ed.AssetCategory].Rarity.DisplayName
                        end)
                        if rar and sellSet[rar] then
                            pcall(function() RF_WearTool:InvokeServer(uid) end)
                            pcall(function() RE_SellPet:FireServer({uid}) end)
                            task.wait(0.1)
                        end
                    end
                end
            end
            task.wait(1)
        end
    end)
end

local MenuGroup = Tabs.Settings:AddLeftGroupbox("Menu")
MenuGroup:AddButton("Unload", function()
    autoCollect = false
    carryingUid = nil
    instantPickup = false
    killAura = false
    autoBuy = false
    autoSell = false
    flyEnabled = false
    stopFly()
    if collectThread then task.cancel(collectThread) end
    if instantThread then task.cancel(instantThread) end
    if killAuraConn then killAuraConn:Disconnect() end
    if autoBuyThread then task.cancel(autoBuyThread) end
    if autoSellThread then task.cancel(autoSellThread) end
    Library:Unload()
end)
