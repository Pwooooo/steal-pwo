    Callback = function(v)
        flyEnabled = v
        if v then startFly() Library:Notify("Fly: ON (WASD + Space/Ctrl)", 2)
        else stopFly() Library:Notify("Fly: OFF", 2) end
    end,
})
RightMain:AddSlider("FlySpeed", {
    Text = "Fly Speed",
    Default = 60,
    Min = 10,
    Max = 300,
    Rounding = 0,
    Callback = function(v) flySpeed = v end,
})

local LeftEggs = Tabs.Eggs:AddLeftGroupbox("Auto Collect")
LeftEggs:AddToggle("AutoCollect", {
    Text = "Auto Collect Eggs",
    Default = false,
    Tooltip = "Guard-aware: skips guarded eggs, instant in-out, returns to safe spot",
    Callback = function(v)
        autoCollect = v
        if v then startCollect() Library:Notify("Auto Collect: ON (guard-aware)", 2)
        else
            if collectThread then task.cancel(collectThread) collectThread = nil end
            Library:Notify("Auto Collect: OFF", 2)
        end
    end,
})
LeftEggs:AddDropdown("CollectWorld", {
    Values = WORLDS,
    Default = 1,
    Multi = false,
    Text = "World",
    Tooltip = "Only collect eggs from this world",
    Callback = function(v) collectWorld = v end,
})
LeftEggs:AddDropdown("CollectRarity", {
    Values = RARITIES,
    Default = 1,
    Multi = false,
    Text = "Rarity",
    Tooltip = "Only collect eggs of this rarity",
    Callback = function(v) collectRarity = v end,
})
eggStatusLabel = LeftEggs:AddLabel("Collected: 0 | Skipped (guard): 0")

local RightEggs = Tabs.Eggs:AddRightGroupbox("Pickup")
RightEggs:AddToggle("InstantPickup", {
    Text = "Instant Egg Pickup",
    Default = false,
    Tooltip = "Removes hold time on egg prompts",
    Callback = function(v)
        instantPickup = v
        if v then startInstant() Library:Notify("Instant Pickup: ON", 2)
        else
            if instantThread then task.cancel(instantThread) instantThread = nil end
            Library:Notify("Instant Pickup: OFF", 2)
        end
    end,
})
RightEggs:AddButton("Collect Nearest Now", function()
    local char = LocalPlayer.Character
    local safeCF = char and char:GetPivot()
    if not safeCF then return end
    local ok, snap = pcall(function()
        return Networking:FindFirstChild("RF/EggWorld/AskFieldEggSnapshot"):InvokeServer()
    end)
    if not (ok and type(snap) == "table") then Library:Notify("Snapshot failed", 2) return end
    local guards = guardPositions()
    local best, bestDist = nil, math.huge
    for _, rec in pairs(snap.Records or {}) do
        if type(rec) == "table" and rec.Uid and rec.BoundsCFrame and rec.State == "Slot" and recordMatches(rec) then
            local safe, _ = eggSafeToGrab(rec, guards)
            if safe then
                local d = (rec.BoundsCFrame.Position - safeCF.Position).Magnitude
                if d < bestDist then bestDist = d best = rec end
            end
        end
    end
    if best then
        if carryEggFast(best, safeCF) then
            eggsCollected = eggsCollected + 1
            if eggStatusLabel then eggStatusLabel:SetText("Collected: " .. eggsCollected .. " | Skipped (guard): " .. eggsSkippedGuard) end
            Library:Notify("Collected 1 egg", 2)
        else
            Library:Notify("Carry rejected (guard moved?)", 2)
        end
    else
        Library:Notify("No safe matching eggs", 2)
    end
end)

local LeftShop = Tabs.Shop:AddLeftGroupbox("Auto Buy")
